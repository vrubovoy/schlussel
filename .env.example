PORT=4000
DATABASE_PATH=./data/schlussel.db
KEYS_DIR=./data/keys
JWT_ISSUER=schlussel

# Public Glocke frontend origin baked into the frontend image by Compose.
GLOCKE_URL=https://glocke.localhost

# Durable platform export jobs. These are deployment-owned internal endpoints;
# API callers cannot supply service URLs. Artifacts are private and short-lived.
# *_MS values are milliseconds; byte limits are raw bytes. The default artifact
# TTL is 24 hours. Responses/downloads are authenticated and marked no-store.
EXPORT_DIR=./data/exports
KUVERT_EXPORT_URL=http://kuvert-backend:3001/exports/me
TAFEL_EXPORT_URL=http://tafel-backend:3002/exports/me
ZETTEL_EXPORT_URL=http://zettel-backend:3003/exports/me
GLOCKE_EXPORT_URL=http://glocke-backend:3004/exports/me
SCHRANK_EXPORT_URL=http://schrank-backend:3005/exports/me
HEROLD_EXPORT_URL=http://herold-backend:3006/exports/me
EXPORT_DISPATCH_INTERVAL_MS=1000
EXPORT_REQUEST_TIMEOUT_MS=15000
EXPORT_LEASE_MS=120000
EXPORT_WORKER_STOP_TIMEOUT_MS=20000
EXPORT_MAX_SERVICE_BYTES=26214400
EXPORT_MAX_AGGREGATE_BYTES=104857600
EXPORT_MAX_CONCURRENCY=1
EXPORT_ARTIFACT_TTL_MS=86400000
EXPORT_USER_COOLDOWN_MS=60000
EXPORT_MAX_RETAINED_JOBS_PER_USER=3
EXPORT_MAX_RETAINED_ARTIFACT_BYTES_PER_USER=314572800
EXPORT_STORAGE_QUOTA_BYTES=1073741824
EXPORT_MIN_FREE_BYTES=268435456

# Durable account deletion saga. Targets are deployment-owned internal
# endpoints. Request timeout must be shorter than the lease.
KUVERT_DELETION_URL=http://kuvert-backend:3001/internal/v1/account-deletions
TAFEL_DELETION_URL=http://tafel-backend:3002/internal/v1/account-deletions
ZETTEL_DELETION_URL=http://zettel-backend:3003/internal/v1/account-deletions
GLOCKE_DELETION_URL=http://glocke-backend:3004/internal/v1/account-deletions
SCHRANK_DELETION_URL=http://schrank-backend:3005/internal/v1/account-deletions
HEROLD_DELETION_URL=http://herold-backend:3006/internal/v1/account-deletions
DELETION_DISPATCH_INTERVAL_MS=1000
DELETION_LEASE_MS=30000
DELETION_FETCH_TIMEOUT_MS=10000
DELETION_WORKER_STOP_TIMEOUT_MS=5000
DELETION_MAX_ATTEMPTS=8
DELETION_RETRY_BASE_DELAY_MS=1000
DELETION_RETRY_MAX_DELAY_MS=900000

# Schlussel -> Glocke event delivery. Both directional secrets are required,
# distinct, and at least 32 bytes.
GLOCKE_BASE_URL=http://glocke-backend:3004
SCHLUSSEL_TO_GLOCKE_HMAC_KEY_ID=schlussel-v1
SCHLUSSEL_TO_GLOCKE_HMAC_SECRET=replace-with-at-least-32-random-bytes

# Separate Glocke -> Schlussel credential for recipient preference lookups.
GLOCKE_TO_SCHLUSSEL_HMAC_KEY_ID=glocke-v1
GLOCKE_TO_SCHLUSSEL_HMAC_SECRET=replace-with-a-distinct-32-byte-secret
GLOCKE_SIGNATURE_MAX_SKEW_SECONDS=300

# Dispatcher timings are positive integer milliseconds. Fetch timeout must be
# shorter than the lease; stop timeout bounds graceful shutdown.
GLOCKE_DISPATCH_INTERVAL_MS=1000
GLOCKE_OUTBOX_LEASE_MS=30000
GLOCKE_FETCH_TIMEOUT_MS=10000
GLOCKE_WORKER_STOP_TIMEOUT_MS=5000
GLOCKE_MAX_ATTEMPTS=8
GLOCKE_RETRY_BASE_DELAY_MS=1000
GLOCKE_RETRY_MAX_DELAY_MS=900000

# Comma-separated CORS origins. Include every separate-origin frontend that
# calls the public /theme endpoint directly for theme sync.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,https://glocke.localhost,https://schloss.example.com,https://kuvert.example.com,https://tafel.example.com,https://zettel.example.com,https://glocke.example.com
