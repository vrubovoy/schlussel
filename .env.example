PORT=4000
DATABASE_PATH=./data/schlussel.db
KEYS_DIR=./data/keys
JWT_ISSUER=schlussel

# Schlussel -> Glocke event delivery. Both directional secrets are required,
# distinct, and at least 32 bytes.
GLOCKE_BASE_URL=http://glocke-backend:3004
SCHLUSSEL_TO_GLOCKE_HMAC_KEY_ID=schlussel-v1
SCHLUSSEL_TO_GLOCKE_HMAC_SECRET=replace-with-at-least-32-random-bytes

# Separate Glocke -> Schlussel credential for recipient preference lookups.
GLOCKE_TO_SCHLUSSEL_HMAC_KEY_ID=glocke-v1
GLOCKE_TO_SCHLUSSEL_HMAC_SECRET=replace-with-a-distinct-32-byte-secret
GLOCKE_SIGNATURE_MAX_SKEW_SECONDS=300

# Dispatcher timings are positive integer milliseconds. Fetch timeout must be
# shorter than the lease; stop timeout bounds graceful shutdown.
GLOCKE_DISPATCH_INTERVAL_MS=1000
GLOCKE_OUTBOX_LEASE_MS=30000
GLOCKE_FETCH_TIMEOUT_MS=10000
GLOCKE_WORKER_STOP_TIMEOUT_MS=5000
GLOCKE_MAX_ATTEMPTS=8
GLOCKE_RETRY_BASE_DELAY_MS=1000
GLOCKE_RETRY_MAX_DELAY_MS=900000

# Comma-separated CORS origins. Include every separate-origin frontend that
# calls the public /theme endpoint directly for theme sync.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,https://glocke.localhost,https://schloss.example.com,https://kuvert.example.com,https://tafel.example.com,https://zettel.example.com,https://glocke.example.com
