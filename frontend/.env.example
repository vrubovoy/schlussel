# Origins accepted by the login/register/account return_to open-redirect guard.
# Keep every local consumer frontend that can initiate one of those navigations here.
VITE_ALLOWED_RETURN_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,https://glocke.localhost

# Launcher used when the hosted login or registration page has no return_to.
VITE_DEFAULT_APP_URL=http://localhost:3000
