# Docker runtime values (Vite development uses public/config.js directly).
# Origins accepted by the login/register/account return_to open-redirect guard.
ALLOWED_RETURN_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177

# Launcher used when the hosted login or registration page has no return_to.
DEFAULT_APP_URL=http://localhost:3000

# Glocke frontend origin used by the authenticated notification bell.
GLOCKE_URL=http://localhost:5177
