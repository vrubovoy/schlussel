{
  "name": "schlussel",
  "version": "0.1.0",
  "description": "Schlüssel — auth service for the Hof platform (RS256 JWT SSO)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @zudar107/schloss-server-kit build",
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm --filter @zudar107/schloss-server-kit build",
    "build": "tsc && node -e \"require('node:fs').cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true })\"",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate.js",
    "db:migrate:dev": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "prelint": "pnpm --filter @zudar107/schloss-server-kit build",
    "lint": "oxlint src",
    "pretest": "pnpm --filter @zudar107/schloss-server-kit build",
    "test": "vitest run",
    "pretest:coverage": "pnpm --filter @zudar107/schloss-server-kit build",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@hono/node-server": "^2.0.10",
    "@hono/zod-validator": "^0.9.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@zudar107/schloss-server-kit": "workspace:*",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "jose": "^6.2.3",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "@types/yazl": "^3.3.1",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
